# MongoDB Atlas: Connect -> Drivers -> copy connection string (thay <password> bằng mật khẩu thật)
# Hoặc MongoDB cài trên máy:  mongodb://localhost:27017
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=cafe
# Mã vào trang quản trị (đổi trước khi demo)
ADMIN_KEY=admin123
